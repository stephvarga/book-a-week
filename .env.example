# Copy this to .env.local and fill in your values
# Never commit .env.local to git

# The password guests will enter to access the site
SITE_PASSWORD=your-password-here

# Resend API key for sending booking emails
# Get one free at https://resend.com
RESEND_API_KEY=re_your_key_here

# Your email address to receive booking requests
OWNER_EMAIL=toaddress@email.com

# The "from" address — must be verified in Resend
FROM_EMAIL=fromaddress@email.com
